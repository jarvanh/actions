__pycache__/
.codebuddy/
# skill 真身在仓库根的 skills/（供所有 AI 工具共用），此处只放行 WorkBuddy 侧的
# 符号链接，其余本地数据（memory 等）仍忽略。
# 注意：必须用 .workbuddy-ai/* + 否定的写法——直接写 /.workbuddy-ai/ 时 git 不会进入
# 该目录，子级的否定规则不生效。
.workbuddy-ai/*
!.workbuddy-ai/skills/
.trae/
# 根目录临时实验脚本与产物（AI 会话残留；2026-09-22 清理后加防护，
# 防外部同步进程再次误入库）
/.*.py
/[0-9]*
